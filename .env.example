# SmartLib Environmental Configuration Example
# Copy this file to a new file named .env and fill in your private details

PORT=3000

# SQLite File name (optional)
DATABASE_FILE=library.db

# SMTP Configuration Details
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@ogr.klu.edu.tr
SMTP_PASS=your_secret_password

# Default System Admin settings
ADMIN_EMAIL=dakormedi79@gmail.com
ADMIN_PASSWORD=admin123

# Application URL (Use your VPS IP or Domain name here so verification emails link correctly)
APP_URL=http://localhost:3000

# JWT signing secrets (REQUIRED). Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do not reuse the example values below in any real deployment.
ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens

# Redis connection string (REQUIRED for BullMQ email queue and node-cron fine processing)
# Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API (CORS).
# Should match the URL(s) the Next.js frontend is served from.
CLIENT_ORIGIN=http://localhost:3000
