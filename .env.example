# SmartLib Environmental Configuration Example
# Copy this file to a new file named .env and fill in your private details

# Must be 5000 unless you also update the hardcoded baseURL in client/src/lib/api.ts
PORT=5000

# PostgreSQL connection string used by the application and Prisma CLI.
# This matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://smartlib:password123@localhost:5432/library?schema=public

# SMTP Configuration Details
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@ogr.klu.edu.tr
SMTP_PASS=your_secret_password

# Default System Admin settings
ADMIN_EMAIL=admin@smartlib.com
ADMIN_PASSWORD=admin123

# Default System Librarian settings
LIBRARIAN_EMAIL=librarian@smartlib.com
LIBRARIAN_PASSWORD=librarian123

# Application URL (Use your VPS IP or Domain name here so verification emails link correctly)
APP_URL=http://localhost:3000

# JWT signing secrets (REQUIRED). Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Do not reuse the example values below in any real deployment.
ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens

# Redis connection string (REQUIRED for BullMQ email queue and node-cron fine processing)
# Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage credentials (REQUIRED).
# Must match the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml locally.
# Do not reuse the example values below in any real deployment.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword

# Comma-separated list of origins allowed to call the API (CORS).
# Should match the URL(s) the Next.js frontend is served from.
CLIENT_ORIGIN=http://localhost:3000
