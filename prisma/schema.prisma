generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model book_copies {
  id         Int          @id @default(autoincrement())
  book_id    Int
  barcode    String       @unique(map: "sqlite_autoindex_book_copies_1")
  status     String       @default("Available")
  books      books        @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  borrowings borrowings[]
}

model books {
  id               Int            @id @default(autoincrement())
  public_id        String?        @unique @default(uuid())
  title            String
  author           String
  genre            String
  isbn             String         @unique(map: "sqlite_autoindex_books_1")
  total_copies     Int            @default(1)
  available_copies Int            @default(1)
  cover_path       String?
  book_copies      book_copies[]
  reservations     reservations[]

  @@index([title])
  @@index([author])
}

model borrowings {
  id          Int         @id @default(autoincrement())
  copy_id     Int
  member_id   Int
  borrow_date String
  due_date    String
  return_date String?
  status      String      @default("borrowed")
  users       users       @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book_copies book_copies @relation(fields: [copy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fines       fines?
}

model fines {
  id           Int        @id @default(autoincrement())
  borrowing_id Int        @unique(map: "sqlite_autoindex_fines_1")
  amount       Float      @default(0.0)
  status       String     @default("unpaid")
  payment_date String?
  borrowings   borrowings @relation(fields: [borrowing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model library_settings {
  key   String @id
  value String
}

model reservations {
  id               Int    @id @default(autoincrement())
  book_id          Int
  member_id        Int
  reservation_date String
  status           String @default("pending")
  users            users  @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  books            books  @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model site_visits {
  id         Int    @id @default(autoincrement())
  visit_time String
}

model student_roster {
  id           Int    @id @default(autoincrement())
  name         String
  student_id   String @unique(map: "sqlite_autoindex_student_roster_1")
  index_number String @unique(map: "sqlite_autoindex_student_roster_2")
}

model users {
  id                 Int            @id @default(autoincrement())
  public_id          String?        @unique @default(uuid())
  username           String         @unique(map: "sqlite_autoindex_users_1")
  password           String
  role               String
  name               String
  email              String
  is_verified        Int?           @default(0)
  verification_token String?
  student_id         String?
  index_number       String?
  reset_token        String?
  reset_token_expiry String?
  account_status     String?        @default("active")
  language           String?        @default("en")
  email_notifications Boolean       @default(true)
  borrowings         borrowings[]
  reservations       reservations[]
  search_history     search_history[]
  support_tickets    support_tickets[]
}

model search_history {
  id        Int    @id @default(autoincrement())
  user_id   Int
  query     String
  timestamp String
  users     users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model purchase_orders {
  id          Int    @id @default(autoincrement())
  title       String
  vendor      String
  quantity    Int
  total_price Float
  status      String @default("pending") // pending, approved, received
  order_date  String
}

model support_tickets {
  id         Int    @id @default(autoincrement())
  member_id  Int
  subject    String
  message    String
  status     String @default("open") // open, resolved
  created_at String
  users      users  @relation(fields: [member_id], references: [id], onDelete: Cascade)
}

model audit_logs {
  id          Int    @id @default(autoincrement())
  admin_id    Int
  action      String
  details     String
  timestamp   String
}

model api_keys {
  id           Int    @id @default(autoincrement())
  service_name String
  token        String
  status       String @default("active")
  created_at   String
}

model compliance_requests {
  id           Int    @id @default(autoincrement())
  member_id    Int
  request_type String // DATA_EXPORT, ACCOUNT_DELETION
  status       String @default("pending")
  created_at   String
}
