generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model book_copies {
  id         Int          @id @default(autoincrement())
  book_id    Int
  barcode    String       @unique
  status     String       @default("Available")
  branch     String?
  section    String?
  shelf      String?
  lost_at    DateTime?
  books      books        @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  borrowings borrowings[]
}

model books {
  id               Int             @id @default(autoincrement())
  public_id        String?         @unique @default(uuid())
  title            String
  author           String
  genre            String
  isbn             String          @unique
  total_copies     Int             @default(1)
  available_copies Int             @default(1)
  cover_path       String?
  book_copies      book_copies[]
  reservations     reservations[]
  contributions    contributions[]

  @@index([title])
  @@index([author])
}

model borrowings {
  id          Int         @id @default(autoincrement())
  copy_id     Int
  member_id   Int
  borrow_date DateTime
  due_date    DateTime
  return_date DateTime?
  status      String      @default("borrowed")
  users       users       @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book_copies book_copies @relation(fields: [copy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fines       fines?

  @@index([member_id])
  @@index([status])
}

model fines {
  id           Int        @id @default(autoincrement())
  borrowing_id Int        @unique
  amount       Float      @default(0.0)
  status       String     @default("unpaid")
  payment_date String?
  borrowings   borrowings @relation(fields: [borrowing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model library_settings {
  key   String @id
  value String
}

model reservations {
  id               Int    @id @default(autoincrement())
  book_id          Int
  member_id        Int
  reservation_date String
  status           String @default("pending")
  users            users  @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  books            books  @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model site_visits {
  id         Int    @id @default(autoincrement())
  visit_time String
}

model student_roster {
  id           Int    @id @default(autoincrement())
  name         String
  student_id   String @unique
  index_number String @unique
}

model users {
  id                  Int               @id @default(autoincrement())
  public_id           String?           @unique @default(uuid())
  username            String            @unique
  password            String
  role                String
  name                String
  email               String
  created_at          DateTime          @default(now())
  is_verified         Int?              @default(0)
  verification_token  String?
  student_id          String?
  index_number        String?
  reset_token         String?
  reset_token_expiry  DateTime?
  reset_code          String?
  reset_code_expiry   DateTime?
  account_status      String?           @default("active")
  language            String?           @default("en")
  email_notifications Boolean           @default(true)
  library_points      Int               @default(0)
  borrowings          borrowings[]
  reservations        reservations[]
  search_history      search_history[]
  support_tickets     support_tickets[]
  contributions       contributions[]
  saved_reports       saved_reports[]

  @@index([email])
}

model search_history {
  id        Int    @id @default(autoincrement())
  user_id   Int
  query     String
  timestamp String
  users     users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model purchase_orders {
  id          Int    @id @default(autoincrement())
  title       String
  vendor      String
  quantity    Int
  total_price Float
  status      String @default("pending") // pending, approved, received
  order_date  String
}

model support_tickets {
  id         Int    @id @default(autoincrement())
  member_id  Int
  subject    String
  message    String
  status     String @default("open") // open, resolved
  created_at String
  users      users  @relation(fields: [member_id], references: [id], onDelete: Cascade)
}

model audit_logs {
  id        Int    @id @default(autoincrement())
  admin_id  Int
  action    String
  details   String
  timestamp String
}

model api_keys {
  id           Int    @id @default(autoincrement())
  service_name String
  token        String
  status       String @default("active")
  created_at   String
}

model compliance_requests {
  id           Int    @id @default(autoincrement())
  member_id    Int
  request_type String // DATA_EXPORT, ACCOUNT_DELETION
  status       String @default("pending")
  created_at   String
}

model contributions {
  id                Int    @id @default(autoincrement())
  member_id         Int
  book_id           Int
  contribution_type String // correction, review, tag
  content           String
  status            String @default("pending") // pending, approved, rejected
  created_at        String
  users             users  @relation(fields: [member_id], references: [id], onDelete: Cascade)
  books             books  @relation(fields: [book_id], references: [id], onDelete: Cascade)
}

model saved_reports {
  id         Int      @id @default(autoincrement())
  owner_id   Int
  name       String
  definition Json
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  users      users    @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id])
  @@index([updated_at])
}
